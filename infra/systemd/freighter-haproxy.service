[Unit]
Description=HAProxy for Freighter apps (dedicated instance)
Documentation=man:haproxy(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# The main config is generated by `freighter host haproxy config`; backends.cfg is rewritten by Freighter on every deploy.
ExecStartPre=/usr/sbin/haproxy -Ws -c -f /etc/freighter/haproxy/haproxy.cfg -f /etc/haproxy/freighter/backends.cfg
ExecStart=/usr/sbin/haproxy -Ws -f /etc/freighter/haproxy/haproxy.cfg -f /etc/haproxy/freighter/backends.cfg -p /run/freighter-haproxy.pid
ExecReload=/usr/sbin/haproxy -Ws -c -f /etc/freighter/haproxy/haproxy.cfg -f /etc/haproxy/freighter/backends.cfg
ExecReload=/bin/sh -c "kill -USR2 $MAINPID"
KillMode=mixed
Restart=always
SuccessExitStatus=143
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
