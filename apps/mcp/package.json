{
  "name": "freighter-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Freighter: look at apps and deployments, deploy, change configuration, and run commands in services",
  "type": "module",
  "bin": {
    "freighter-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/bundle.mjs src/index.ts dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@freighter/tsconfig": "workspace:*"
  }
}
