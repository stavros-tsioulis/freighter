{
  "name": "@freighter/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "pnpm build && node --enable-source-maps dist/main.js",
    "build": "node ../../scripts/bundle.mjs src/main.ts dist/main.js"
  },
  "dependencies": {
    "@freighter/core": "workspace:*",
    "@freighter/protocol": "workspace:*",
    "@freighter/systemd": "workspace:*",
    "@freighter/haproxy": "workspace:*",
    "@freighter/manifest": "workspace:*",
    "zod": "^3.25.0",
    "@freighter/pki": "workspace:*",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@freighter/tsconfig": "workspace:*",
    "@freighter/manifest": "workspace:*"
  },
  "bin": {
    "freighter-agent": "./dist/main.js"
  }
}
