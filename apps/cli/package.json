    "@freighter/pki": "workspace:*",
    "@freighter/registry": "workspace:*",
    "@freighter/systemd": "workspace:*",
    "citty": "^0.1.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@freighter/protocol": "workspace:*",
    "@freighter/tsconfig": "workspace:*",
    "@types/ws": "8.18.1",
    "h3": "^1.15.0",
    "ws": "8.18.3",
    "@freighter/agent": "workspace:*"
  },
  "bin": {
    "freighter": "./dist/cli.js"
