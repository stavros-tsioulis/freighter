{
  "name": "freighter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @freighter/dashboard dev",
    "docs": "pnpm --filter @freighter/docs dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "lab": "./docker/lab.sh",
    "lab:up": "./docker/lab.sh up",
    "lab:down": "./docker/lab.sh down",
    "lab:smoke": "./docker/lab.sh smoke"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
